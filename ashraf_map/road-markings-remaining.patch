+async function loadPaintPrimitives(meshNames: PaintMeshName[]): Promise<Cesium.Primitive[]> {
+  const files = await Promise.all(meshNames.map(async (meshName) => {
+    const response = await fetch(`/data/${meshName}.bin`);
+    if (!response.ok) throw new Error(`Unable to load ${meshName}.bin (${response.status})`);
+    const bytes = await response.arrayBuffer();
+    if (bytes.byteLength % (8 * Float32Array.BYTES_PER_ELEMENT) !== 0) {
+      throw new Error(`Invalid geometry file: ${meshName}.bin`);
+    }
+    return { meshName, floats: new Float32Array(bytes) };
+  }));
+
+  const primitives: Cesium.Primitive[] = [];
+  for (const { meshName, floats } of files) {
+    const quadCount = floats.length / 8;
+    for (let q = 0; q < quadCount; q += MAX_QUADS_PER_PRIMITIVE) {
+      primitives.push(
+        buildPaintPrimitive(
+          floats,
+          q,
+          Math.min(MAX_QUADS_PER_PRIMITIVE, quadCount - q),
+          PAINT_MESHES[meshName]
+        )
       );
-    })
-  );
+    }
+  }
+  return primitives;
 }
 
